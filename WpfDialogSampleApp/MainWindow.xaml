<Window
    x:Class="WpfDialogSampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfDialogSampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WPF MVVM ダイアログサンプル"
    Width="600"
    Height="400"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0" 
                   Text="{Binding WelcomeMessage}" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- メインコンテンツ -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="以下のボタンをクリックしてダイアログを表示できます：" 
                       FontSize="14" 
                       Margin="0,0,0,20"/>
            
            <StackPanel Margin="0,20,0,0">
                <Button Content="ユーザー情報入力ダイアログ" 
                        Command="{Binding ShowUserInfoDialogCommand}"
                        Padding="20,10"
                        FontSize="14"
                        Background="#FF0078D4"
                        Foreground="White"
                        Margin="0,0,0,15"/>
                
                <Button Content="メッセージダイアログ" 
                        Command="{Binding ShowMessageDialogCommand}"
                        Padding="20,10"
                        FontSize="14"
                        Margin="0,0,0,15"/>
                
                <Button Content="確認ダイアログ" 
                        Command="{Binding ShowConfirmationDialogCommand}"
                        Padding="20,10"
                        FontSize="14"/>
            </StackPanel>

            <Border Background="#F0F0F0" 
                    Padding="15" 
                    CornerRadius="5" 
                    Margin="0,20,0,0">
                <TextBlock Text="{Binding UserInfoDisplay}" 
                           FontSize="12" 
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- フッター -->
        <TextBlock Grid.Row="2" 
                   Text="MVVMパターンを使用したWPFダイアログサンプル" 
                   FontSize="10" 
                   Foreground="Gray" 
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
    </Grid>
</Window>
