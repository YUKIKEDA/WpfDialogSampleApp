<Window
    x:Class="WpfDialogSampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfDialogSampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dialogs="clr-namespace:WpfDialogSampleApp.Core.Dialogs.Views;assembly=WpfDialogSampleApp.Core"
    xmlns:userInfoDialog="clr-namespace:WpfDialogSampleApp.Dialogs.UserInfoDialog"
    xmlns:confirmDialog="clr-namespace:WpfDialogSampleApp.Dialogs.ConfirmDialog"
    Title="WPF MVVM ダイアログサンプル"
    Width="600"
    Height="400"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <!-- メインコンテンツ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
            <TextBlock Text="WPF ダイアログサンプルアプリケーション" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>
            
            <!-- ダイアログ実行ボタン -->
            <Button Content="ユーザー情報ダイアログを開く" 
                    Command="{Binding ShowUserInfoDialogCommand}"
                    Padding="20,10" 
                    MinWidth="200"
                    Margin="0,0,0,30"/>
            
            <!-- 結果表示エリア -->
            <Border BorderBrush="LightGray" 
                    BorderThickness="1" 
                    Padding="20" 
                    CornerRadius="5"
                    Background="AliceBlue">
                <StackPanel>
                    <TextBlock Text="ダイアログ実行結果:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="結果:" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LastResult.Value}" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="名前:" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastName.Value}" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="メール:" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastEmail.Value}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <!-- ダイアログオーバーレイ -->
        <dialogs:DialogView DataContext="{Binding DialogViewModel}">
            <dialogs:DialogView.Resources>
                <ResourceDictionary>
                    <DataTemplate DataType="{x:Type userInfoDialog:UserInfoDialogViewModel}">
                        <userInfoDialog:UserInfoDialogView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type confirmDialog:ConfirmDialogViewModel}">
                        <confirmDialog:ConfirmDialogView/>
                    </DataTemplate>
                </ResourceDictionary>
            </dialogs:DialogView.Resources>
        </dialogs:DialogView>
    </Grid>
</Window>
