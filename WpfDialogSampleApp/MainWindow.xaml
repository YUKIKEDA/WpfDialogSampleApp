<Window
    x:Class="WpfDialogSampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfDialogSampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WPF MVVM ダイアログサンプル"
    Width="600"
    Height="400"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ヘッダー  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,30"
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="Bold"
            Text="{Binding WelcomeMessage}" />

        <!--  メインコンテンツ  -->
        <StackPanel Grid.Row="1">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="14"
                Text="以下のボタンをクリックしてダイアログを表示できます：" />

            <StackPanel Margin="0,20,0,0">
                <Button
                    Margin="0,0,0,15"
                    Padding="20,10"
                    Background="#FF0078D4"
                    Command="{Binding ShowUserInfoDialogCommand}"
                    Content="ユーザー情報入力ダイアログ（非モーダル）"
                    FontSize="14"
                    Foreground="White" />

                <Button
                    Margin="0,0,0,15"
                    Padding="20,10"
                    Background="#FF28A745"
                    Command="{Binding ShowUserInfoDialogModalAsyncCommand}"
                    Content="ユーザー情報入力ダイアログ（非同期モーダル）"
                    FontSize="14"
                    Foreground="White" />

                <Button
                    Margin="0,0,0,15"
                    Padding="20,10"
                    Command="{Binding ShowMessageDialogCommand}"
                    Content="メッセージダイアログ"
                    FontSize="14" />

                <Button
                    Padding="20,10"
                    Command="{Binding ShowConfirmationDialogCommand}"
                    Content="確認ダイアログ"
                    FontSize="14" />
            </StackPanel>

            <Border
                Margin="0,20,0,0"
                Padding="15"
                Background="#F0F0F0"
                CornerRadius="5">
                <TextBlock
                    FontSize="12"
                    Text="{Binding UserInfoDisplay}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!--  フッター  -->
        <TextBlock
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            FontSize="10"
            Foreground="Gray"
            Text="MVVMパターンを使用したWPFダイアログサンプル" />
    </Grid>
</Window>
