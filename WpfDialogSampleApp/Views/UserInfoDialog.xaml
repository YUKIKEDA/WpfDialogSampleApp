<Window x:Class="WpfDialogSampleApp.Views.UserInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="{Binding Title}"
        Width="400"
        Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <TextBlock Grid.Row="0" 
                   Text="ユーザー情報を入力してください" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- 入力フォーム -->
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,15">
                <Label Content="名前:" FontWeight="Bold"/>
                <TextBox Text="{Binding UserInfo.Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,0"
                         Padding="5"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,15">
                <Label Content="メールアドレス:" FontWeight="Bold"/>
                <TextBox Text="{Binding UserInfo.Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,0"
                         Padding="5"/>
            </StackPanel>

            <StackPanel>
                <Label Content="年齢:" FontWeight="Bold"/>
                <TextBox Text="{Binding UserInfo.Age, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,0"
                         Padding="5"/>
            </StackPanel>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="リセット" 
                    Command="{Binding ResetCommand}"
                    Padding="15,5"
                    MinWidth="80"
                    Margin="0,0,10,0"/>
            <Button Content="キャンセル" 
                    Command="{Binding CancelCommand}"
                    Padding="15,5"
                    MinWidth="80"
                    Margin="0,0,10,0"/>
            <Button Content="保存" 
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsValid}"
                    Padding="15,5"
                    MinWidth="80"
                    Background="#FF0078D4"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
