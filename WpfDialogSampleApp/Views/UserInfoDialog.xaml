<Window
    x:Class="WpfDialogSampleApp.Views.UserInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WpfDialogSampleApp.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:WpfDialogSampleApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="400"
    Height="350"
    mc:Ignorable="d">

    <i:Interaction.Behaviors>
        <behaviors:DialogBehavior />
    </i:Interaction.Behaviors>
    <Border
        Margin="20"
        Background="White"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Direction="270"
                Opacity="0.3"
                ShadowDepth="5"
                Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ヘッダー  -->
            <Border
                Grid.Row="0"
                Height="40"
                Background="#FF0078D4"
                CornerRadius="8,8,0,0">
                <Grid>
                    <TextBlock
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding Title}" />
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CancelCommand}"
                        Content="×"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White" />
                </Grid>
            </Border>

            <!--  メインコンテンツ  -->
            <StackPanel Grid.Row="1" Margin="20">
                <!--  ヘッダー  -->
                <TextBlock
                    Margin="0,20,0,20"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="ユーザー情報を入力してください" />

                <!--  入力フォーム  -->
                <StackPanel>
                    <StackPanel Margin="0,0,0,15">
                        <Label Content="名前:" FontWeight="Bold" />
                        <TextBox
                            Margin="0,5,0,0"
                            Padding="5"
                            Text="{Binding UserInfo.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <Label Content="メールアドレス:" FontWeight="Bold" />
                        <TextBox
                            Margin="0,5,0,0"
                            Padding="5"
                            Text="{Binding UserInfo.Email, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel>
                        <Label Content="年齢:" FontWeight="Bold" />
                        <TextBox
                            Margin="0,5,0,0"
                            Padding="5"
                            Text="{Binding UserInfo.Age, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  ボタン  -->
            <StackPanel
                Grid.Row="2"
                Margin="20,20,20,20"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Padding="15,5"
                    Command="{Binding ResetCommand}"
                    Content="リセット" />
                <Button
                    MinWidth="80"
                    Margin="0,0,10,0"
                    Padding="15,5"
                    Command="{Binding CancelCommand}"
                    Content="キャンセル" />
                <Button
                    MinWidth="80"
                    Padding="15,5"
                    Background="#FF0078D4"
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    Foreground="White"
                    IsEnabled="{Binding IsValid}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
